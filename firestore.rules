rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cada cofre é um documento cujo id (64 caracteres) é derivado da senha mestra.
    // Só dá para ler/gravar sabendo o id; listar ou apagar é proibido.
    match /vaults/{id} {
      allow get: if id.size() == 64;
      allow create, update: if id.size() == 64
        && request.resource.data.keys().hasOnly(['salt', 'data', 'updated'])
        && request.resource.data.data is string
        && request.resource.data.data.size() < 900000;
      allow list, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
